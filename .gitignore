# Permisos y configuracion local de Claude Code para esta maquina: no es
# parte del proyecto, y trae rutas absolutas de este equipo especifico.
.claude/settings.local.json

# node_modules y dist ya se ignoran dentro de client/ y server/, pero un
# .gitignore en la raiz cubre por si algun dia se agrega otra carpeta con
# dependencias propias.
node_modules/
dist/

# La clave del encargado. Cada computadora tiene la suya y NUNCA se sube:
# este repositorio se usa para instalar el sistema en otra maquina, y subir
# la clave la publicaria junto con el codigo.
.env

# La base de datos con las ventas reales. No va al repositorio por dos
# razones: trae informacion del negocio (cuentas, cobros, personal), y cambia
# cada hora, asi que cada commit seria un archivo binario distinto. Para pasar
# el historial a otra computadora se copia aparte (ver COMO-INSTALAR.md).
server/datos/*.db
server/datos/*.db-wal
server/datos/*.db-shm
server/datos/respaldos/
server/datos/servidor.log
