{
  "name": "taqueria-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor local de pedidos para taqueria (LAN, sin internet)",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test-force-exit --test \"tests/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
